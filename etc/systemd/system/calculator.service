[Unit]
Description=System Calculator Service
After=dbus.service network.target postgresql.service redis-server.service
Requires=dbus.service

[Service]
Type=dbus
BusName=com.example.CalculatorService
# Run as root for system service privileges
# User=calculator
# Group=calculator
ExecStart=/usr/local/bin/calculator --config /usr/local/etc/calculator.json
Restart=always
RestartSec=3s
WorkingDirectory=/usr/local/bin

[Install]
WantedBy=multi-user.target