#!/bin/bash

PG_USER="calc"
PG_DB="calc"
PG_PASSWORD="calc_password"

setup_database() {
    # postgres может быть не запущен сразу после установки зависимостей
    if ! systemctl is-active --quiet postgresql; then
        echo "Запускаем postgresql"
        systemctl start postgresql
    fi

    # ждём готовности (initdb + старт могут занять время)
    for i in $(seq 1 10); do
        if sudo -u postgres pg_isready -q; then
            break
        fi
        echo "Ожидаем готовности postgres ($i)..."
        sleep 1
    done

    # идемпотентное создание роли
    if ! sudo -u postgres psql -tAc \
        "SELECT 1 FROM pg_roles WHERE rolname='${PG_USER}'" | grep -q 1; then
        echo "Создаём роль ${PG_USER}"
        sudo -u postgres psql -c \
            "CREATE USER ${PG_USER} WITH PASSWORD '${PG_PASSWORD}'"
    fi

    # идемпотентное создание базы
    if ! sudo -u postgres psql -tAc \
        "SELECT 1 FROM pg_database WHERE datname='${PG_DB}'" | grep -q 1; then
        echo "Создаём базу ${PG_DB}"
        sudo -u postgres createdb -O "${PG_USER}" "${PG_DB}"
    fi
}

case "$1" in
    configure)
        setup_database

        echo "Перечитываем конфигурации systemd"
        systemctl daemon-reload

        echo "Перечитываем конфигурацию D-Bus"
        systemctl reload dbus.service || true

        echo "Запускаем calculator"
        systemctl enable calculator
        systemctl restart calculator
        ;;
esac

exit 0